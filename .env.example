# ---- Google Drive (landing zone) ----
GDRIVE_FOLDER_ID=
# Option A: service account (preferred for automation, may be blocked by
# an organization policy, see docs/google_drive_setup.md)
GDRIVE_SERVICE_ACCOUNT_JSON=./config/gdrive_service_account.json
# Option B: OAuth, your own Google account via one-time browser consent,
# no service account key needed. Leave GDRIVE_SERVICE_ACCOUNT_JSON's file
# missing and set this instead.
GDRIVE_OAUTH_CLIENT_SECRET_JSON=./config/gdrive_oauth_client_secret.json
GDRIVE_OAUTH_TOKEN_JSON=./config/gdrive_oauth_token.json
# Set true to force local-simulation mode (manually downloaded or
# scripts.simulate_weekly_drop CSVs in data/landing/<run_id>/) regardless
# of whether the files above exist. Useful while still debugging Drive
# auth, flip back to false once it's working.
GDRIVE_FORCE_LOCAL=false

# ---- Snowflake ----
# Three databases, one per pipeline layer: NEXORA_RAW_WH (faithful,
# string-typed copies of validated files), NEXORA_STAGING_WH (typed and
# standardized), NEXORA_PROD_WH (the reporting marts). Run audit trail lives
# in NEXORA_RAW_WH.AUDIT.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=NEXORA_LOADER
SNOWFLAKE_WAREHOUSE=NEXORA_WH
SNOWFLAKE_DATABASE_RAW=NEXORA_RAW_WH
SNOWFLAKE_DATABASE_STAGING=NEXORA_STAGING_WH
SNOWFLAKE_DATABASE_PROD=NEXORA_PROD_WH
# password (default), externalbrowser (needs SAML/SSO configured on the
# account, fails on plain trial accounts), or keypair (bypasses
# password/MFA entirely, works everywhere, standard for CI). See
# docs/snowflake_setup.md if your account's MFA blocks plain password login.
SNOWFLAKE_AUTH_METHOD=password
SNOWFLAKE_PRIVATE_KEY_PATH=./config/snowflake_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ---- Slack ----
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ---- Email ----
# EMAIL_PROVIDER: "resend" (default, simplest) or "smtp"
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=CareSync <alerts@resend.dev>
# Only needed if EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=ops-team@nexorahealth.example

# ---- SLA / scheduling ----
FILE_ARRIVAL_SLA_MINUTES=60
SCHEDULED_DELIVERY_TIME_UTC=06:00

# ---- Phase 2 only: SFTP (replaces Google Drive polling assumptions in docs) ----
SFTP_HOST=
SFTP_USER=
SFTP_KEY_PATH=
