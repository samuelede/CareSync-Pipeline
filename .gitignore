validation/great_expectations/uncommitted/

# data (synthetic, but keep the repo light)
# Trailing-slash directory patterns, not *.csv globs: `*` doesn't cross a
# `/` in gitignore, so `data/landing/*.csv` never matched the real files,
# which live one level deeper at data/landing/<run_id>/*.csv.
data/landing/*/
!data/landing/.gitkeep
!data/landing/README.md
data/audit/
quarantine/*/
!quarantine/.gitkeep

# airflow
orchestration/airflow/logs/
orchestration/airflow/airflow.db
